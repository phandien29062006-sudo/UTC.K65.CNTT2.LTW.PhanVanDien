
@model WebApplication2.Models.Learner

@{
    ViewData["Title"] = "Delete";
}

<div class="container mt-4">
    <h2>Delete Learner</h2>

    <h4>Bạn có chắc chắn muốn xóa người học này không?</h4>

    <hr />

    <dl class="row">
        <dt class="col-sm-3">Mã người học</dt>
        <dd class="col-sm-9">@Model.LearnerID</dd>

        <dt class="col-sm-3">Tên</dt>
        <dd class="col-sm-9">@Model.FirstMidName</dd>

        <dt class="col-sm-3">Họ</dt>
        <dd class="col-sm-9">@Model.LastName</dd>

        <dt class="col-sm-3">Ngành học</dt>
        <dd class="col-sm-9">@Model.Major?.MajorName</dd>

        <dt class="col-sm-3">Ngày nhập học</dt>
        <dd class="col-sm-9">
            @Model.EnrollmentDate.ToString("dd/MM/yyyy")
        </dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="LearnerID" />

        <button type="submit" class="btn btn-danger">
            Delete
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Back to List
        </a>
    </form>
</div>
