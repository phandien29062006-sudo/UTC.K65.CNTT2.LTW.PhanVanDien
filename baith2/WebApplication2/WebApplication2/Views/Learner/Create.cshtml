
@model WebApplication2.Models.Learner

@{
    ViewData["Title"] = "Create";
}

<div class="container mt-4">
    <h2>Create</h2>

    <form asp-controller="Learner"
          asp-action="Create"
          method="post">

        <div asp-validation-summary="All"
             class="text-danger"></div>

        <div class="form-group row mt-3">
            <label asp-for="FirstMidName"
                   class="col-sm-2 col-form-label">
                Tên
            </label>
            <div class="col-sm-10">
                <input asp-for="FirstMidName"
                       class="form-control"
                       placeholder="First Mid Name" />
                <span asp-validation-for="FirstMidName"
                      class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mt-3">
            <label asp-for="LastName"
                   class="col-sm-2 col-form-label">
                Họ
            </label>
            <div class="col-sm-10">
                <input asp-for="LastName"
                       class="form-control"
                       placeholder="Last Name" />
                <span asp-validation-for="LastName"
                      class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mt-3">
            <label asp-for="MajorID"
                   class="col-sm-2 col-form-label">
                Ngành học
            </label>
            <div class="col-sm-10">
                <select asp-for="MajorID"
                        asp-items="ViewBag.MajorID"
                        class="form-select">
                    <option value="">-- Chọn ngành học --</option>
                </select>
                <span asp-validation-for="MajorID"
                      class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row mt-3">
            <label asp-for="EnrollmentDate"
                   class="col-sm-2 col-form-label">
                Ngày nhập học
            </label>
            <div class="col-sm-10">
                <input asp-for="EnrollmentDate"
                       type="date"
                       class="form-control" />
                <span asp-validation-for="EnrollmentDate"
                      class="text-danger"></span>
            </div>
        </div>

        <div class="mt-3">
            <button type="submit"
                    class="btn btn-primary">
                Create
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back to List
            </a>
        </div>
    </form>
</div>
