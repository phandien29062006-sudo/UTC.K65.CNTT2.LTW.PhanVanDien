
@model WebApplication2.Models.Learner

@{
    ViewData["Title"] = "Edit";
}

<div class="container mt-4">
    <h2>Edit Learner</h2>

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="LearnerID" />

        <div asp-validation-summary="All"
             class="text-danger"></div>

        <div class="form-group mt-3">
            <label asp-for="FirstMidName">Tên</label>
            <input asp-for="FirstMidName" class="form-control" />
            <span asp-validation-for="FirstMidName"
                  class="text-danger"></span>
        </div>

        <div class="form-group mt-3">
            <label asp-for="LastName">Họ</label>
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName"
                  class="text-danger"></span>
        </div>

        <div class="form-group mt-3">
            <label asp-for="MajorID">Ngành học</label>
            <select asp-for="MajorID"
                    asp-items="ViewBag.MajorID"
                    class="form-select">
            </select>
            <span asp-validation-for="MajorID"
                  class="text-danger"></span>
        </div>

        <div class="form-group mt-3">
            <label asp-for="EnrollmentDate">Ngày nhập học</label>
            <input asp-for="EnrollmentDate"
                   type="date"
                   class="form-control" />
            <span asp-validation-for="EnrollmentDate"
                  class="text-danger"></span>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">
                Save
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Back to List
            </a>
        </div>
    </form>
</div>
