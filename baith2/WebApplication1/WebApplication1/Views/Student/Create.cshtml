@model WebApplication1.Models.Student

@{
    ViewData["Title"] = "Thêm sinh viên";
}

<h2>Thêm sinh viên</h2>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-controller="Student" asp-action="Create" method="post">
    <div class="form-group mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" placeholder="Họ tên" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" placeholder="Email@gmail.com" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" type="password" class="form-control"
               placeholder="Nhập mật khẩu" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Branch" class="form-label"></label>
        <select asp-for="Branch"
                asp-items="Html.GetEnumSelectList<Branch>()"
                class="form-select">
            <option value="">-- Chọn ngành học --</option>
        </select>
        <span asp-validation-for="Branch" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Gender" class="form-label"></label>
        @foreach (var gender in Enum.GetValues<Gender>())
        {
            <div class="form-check">
                <input asp-for="Gender" type="radio"
                       value="@gender" class="form-check-input" />
                <label class="form-check-label">@gender</label>
            </div>
        }
        <span asp-validation-for="Gender" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="IsRegular" class="form-label"></label>
        <input asp-for="IsRegular" type="checkbox"
               class="form-check-input" />
        <span asp-validation-for="IsRegular" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Address" class="form-label"></label>
        <textarea asp-for="Address" class="form-control"
                  placeholder="Địa chỉ"></textarea>
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="DateOfBirth" class="form-label"></label>
        <input asp-for="DateOfBirth" type="date" class="form-control" />
        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Score" class="form-label"></label>
        <input asp-for="Score" type="number" step="any"
               min="0" max="10" class="form-control" />
        <span asp-validation-for="Score" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-controller="Student" asp-action="Index"
       class="btn btn-secondary">Quay lại</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
