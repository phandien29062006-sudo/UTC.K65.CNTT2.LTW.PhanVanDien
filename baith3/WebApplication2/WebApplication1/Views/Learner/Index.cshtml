@model IEnumerable<WebApplication1.Models.Learner>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="m-5">
    <h1>Learner List</h1>

    @await Component.InvokeAsync("Major")

    <!-- Form tìm kiếm -->
    <form id="searchForm" class="d-inline-block my-2">
        <div class="input-group">
            <input id="keyword"
                   class="form-control"
                   type="text"
                   placeholder="Search learner"
                   style="width: 300px;" />

            <button id="btnSearch"
                    class="btn btn-primary"
                    type="submit">
                <i class="fas fa-search"></i>
                Tìm kiếm
            </button>
        </div>
    </form>

    <!-- Danh sách Learner -->
    <div id="content">
        @await Html.PartialAsync("LearnerTable", Model)
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Create New Student
    </a>
</div>

@section Scripts {
    <script>
        // Hàm gọi AJAX để lọc, tìm kiếm và phân trang
        function loadLearners(mid, keyword, pageIndex) {
            $.ajax({
                url: "/Learner/LearnerFilter",
                data: {
                    mid: mid,
                    keyword: keyword,
                    pageIndex: pageIndex
                },
                success: function (response) {
                    $("#content").html(response);
                },
                error: function () {
                    alert("Không thể tải danh sách Learner!");
                }
            });
        }

        // Click vào số trang
        $("body").on("click", "li.page-item", function (e) {
            e.preventDefault();

            var page = $(this).attr("data-page");
            var mid = $(this).attr("data-mid");
            var keyword = $("#keyword").val();

            loadLearners(mid, keyword, page);
        });

        // Click vào chuyên ngành Major
        $("body").on("click", ".nav li", function (e) {
            e.preventDefault();

            var mid = $(this).attr("id");
            var keyword = $("#keyword").val();

            loadLearners(mid, keyword, 1);
        });
        // Click nút tìm kiếm
        $("#searchForm").submit(function (e) {
            e.preventDefault();

            var keyword = $("#keyword").val();
            var mid = $(".nav li.active").attr("id");

            loadLearners(mid, keyword, 1);
        });
    </script>
}
