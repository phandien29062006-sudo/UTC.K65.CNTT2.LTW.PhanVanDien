
@model WebApplication1.Models.Learner

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit Student</h1>

<div class="row">
    <div class="col-md-6">
      <form asp-action="Edit" asp-route-id="@Model.LearnerId" method="post">
            <input type="hidden" asp-for="LearnerId" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="FirstMidName">Tên</label>
                <input asp-for="FirstMidName" class="form-control" />
                <span asp-validation-for="FirstMidName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="LastName">Họ</label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="EnrollmentDate">Ngày nhập học</label>
                <input asp-for="EnrollmentDate" type="date" class="form-control" />
                <span asp-validation-for="EnrollmentDate" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="MajorId">Chuyên ngành</label>
                <select asp-for="MajorId"
                        asp-items="ViewBag.MajorId"
                        class="form-control">
                    <option value="">-- Chọn chuyên ngành --</option>
                </select>   
                <span asp-validation-for="MajorId" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </form>
    </div>
</div>
