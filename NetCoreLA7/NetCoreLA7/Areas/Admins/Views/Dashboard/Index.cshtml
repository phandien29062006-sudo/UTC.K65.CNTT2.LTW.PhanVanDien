
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admins/Views/Shared/_Admins.cshtml";
}

<div class="row">

    <!-- Thẻ Sản phẩm -->
    <div class="col-lg-4 col-12">
        <div class="small-box text-bg-primary">
            <div class="inner">
                <h3>120</h3>
                <p>Sản phẩm</p>
            </div>
            <i class="small-box-icon bi bi-box-seam"></i>
            <a href="#" class="small-box-footer">
                Quản lý sản phẩm
                <i class="bi bi-arrow-right-circle"></i>
            </a>
        </div>
    </div>

    <!-- Thẻ Khách hàng -->
    <div class="col-lg-4 col-12">
        <div class="small-box text-bg-success">
            <div class="inner">
                <h3>85</h3>
                <p>Khách hàng</p>
            </div>
            <i class="small-box-icon bi bi-people"></i>
            <a href="#" class="small-box-footer">
                Quản lý khách hàng
                <i class="bi bi-arrow-right-circle"></i>
            </a>
        </div>
    </div>

    <!-- Thẻ Đơn hàng -->
    <div class="col-lg-4 col-12">
        <div class="small-box text-bg-warning">
            <div class="inner">
                <h3>36</h3>
                <p>Đơn hàng</p>
            </div>
            <i class="small-box-icon bi bi-cart"></i>
            <a href="#" class="small-box-footer">
                Quản lý đơn hàng
                <i class="bi bi-arrow-right-circle"></i>
            </a>
        </div>
    </div>

</div>

<!-- Khu vực giới thiệu -->
<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="bi bi-speedometer2 me-2"></i>
            Tổng quan hệ thống
        </h3>
    </div>

    <div class="card-body">
        <h5>Chào mừng đến với NetCoreLA7 Admin!</h5>
        <p class="mb-0">
            Đây là trang Dashboard quản lý hệ thống.
            Bạn có thể phát triển thêm chức năng quản lý sản phẩm,
            khách hàng và đơn hàng tại đây.
        </p>
    </div>
</div>
