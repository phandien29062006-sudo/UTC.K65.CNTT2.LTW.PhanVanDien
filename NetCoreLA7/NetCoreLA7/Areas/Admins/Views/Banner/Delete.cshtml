
@model NetCoreLA7.Areas.Admins.Models.Banner

@{
    ViewData["Title"] = "Xóa Banner";
    Layout = "~/Areas/Admins/Views/Shared/_Admins.cshtml";
}

<div class="container-fluid">
    <h3 class="mb-3">Xóa Banner</h3>

    <div class="card">
        <div class="card-body">
            <p>Bạn có chắc chắn muốn xóa Banner này không?</p>

            <dl class="row">
                <dt class="col-sm-3">Mã Banner</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">Tiêu đề</dt>
                <dd class="col-sm-9">@Model.Title</dd>

                <dt class="col-sm-3">Ảnh</dt>
                <dd class="col-sm-9">@Model.Image</dd>

                <dt class="col-sm-3">Đường dẫn</dt>
                <dd class="col-sm-9">@Model.Link</dd>

                <dt class="col-sm-3">Trạng thái</dt>
                <dd class="col-sm-9">
                    @(Model.Status == 1 ? "Hiển thị" : "Ẩn")
                </dd>
            </dl>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-danger">
                    Xác nhận xóa
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Hủy
                </a>
            </form>
        </div>
    </div>
</div>
