@{
    ViewData["Title"] = "Trang chủ";
}

<div class="container">
    <div class="banner">
        <div class="banner-top">
            <h2>
                Microsoft Azure
            </h2>

            <div class="separator"></div>

            <div class="azure-icons">
                <span>🌐</span>
                <span>◇</span>
                <span>DB</span>
                <span>▦</span>
            </div>

        </div>
        <div class="arrow arrow-left">
            ‹
        </div>
        <div class="arrow arrow-right">
            ›
        </div>

        <p class="banner-description">
            Learn how Microsoft's Azure cloud platform allows you to build, deploy, and
                <br>scale web apps.
            <button class="btn btn-light">Learn More</button>
         </p>
     
        <div class="banner-dots">
            <span class="dot"></span>
            <span class="dot"></span>
            <span class="active"></span>
        </div>
    </div>

    <h2 class="mt-4 mb-3">Danh sách sản phẩm</h2>
    <div class="row">
        <div class="col-md-3">
            <div class="card">
                <img src="~/images/product1.jpg" class="card-img-top" alt="Product 1">
                <div class="card-body text-center">
                    <h5 class="card-title">Product Name 1</h5>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <img src="~/images/product2.jpg" class="card-img-top" alt="Product 2">
                <div class="card-body text-center">
                    <h5 class="card-title">Product Name 2</h5>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <img src="~/images/product3.avif" class="card-img-top" alt="Product 3">
                <div class="card-body text-center">
                    <h5 class="card-title">Product Name 3</h5>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <img src="~/images/product4.webp" class="card-img-top" alt="Product 4">
                <div class="card-body text-center">
                    <h5 class="card-title">Product Name 4</h5>
                </div>
            </div>
        </div>
    </div>
</div>