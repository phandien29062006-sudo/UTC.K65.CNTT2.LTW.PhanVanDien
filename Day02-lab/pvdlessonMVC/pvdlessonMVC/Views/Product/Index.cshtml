@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

<div class="container">

    <h2 class="product-title">
        Quản lý sản phẩm
    </h2>

    <table class="product-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Price</th>
                <th>Created At</th>
                <th>Image</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>1</td>
                <td>Product 1</td>
                <td>500,000 đ</td>
                <td>25-12-2020</td>
                <td>
                    <img src="~/images/product1.jpg"
                         class="product-small-image"
                         alt="Product 1" />
                </td>
                <td>
                    <button class="view-button">
                        View
                    </button>
                </td>
            </tr>

            <tr>
                <td>2</td>
