<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - NetCoreMVCLab03</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- CSS của project -->
    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body>

    <!-- MENU -->
    <nav class="navbar navbar-expand-sm navbar-dark bg-dark">
        <div class="container">

            <a class="navbar-brand"
               asp-controller="Home"
               asp-action="Index">
                NetCoreMVCLab03
            </a>
            <div class="navbar-collapse collapse d-sm-inline-flex">
                <div class="navbar-nav">
                  <a class="nav-link"
                   asp-controller="Home"
                   asp-action="Index">
                    Trang chủ
                </a>

                <a class="nav-link"
                   asp-controller="Home"
                   asp-action="About">
                    Giới thiệu
                      </a>

                 <a class="nav-link"
                   asp-controller="Home"
                   asp-action="Contact">
                    Liên hệ
                   </a>

                 <a class="nav-link"
                   asp-controller="Book"
                   asp-action="Index">
                    Sách
                 </a>
                </div>
            </div>

        </div>
    </nav>

    <!-- NỘI DUNG CỦA TỪNG VIEW -->
    <div class="container">
        @RenderBody()
    </div>

    <!-- FOOTER -->
    <footer class="border-top mt-4 py-3">
        <div class="container">
            © 2026 - NetCoreMVCLab03 -
            <a asp-controller="Home" asp-action="Privacy">
                Privacy
            </a>
        </div>
    </footer>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Script riêng của từng View -->
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>