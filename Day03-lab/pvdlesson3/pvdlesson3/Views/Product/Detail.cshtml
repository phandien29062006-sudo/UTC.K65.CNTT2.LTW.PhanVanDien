@{
    ViewData["Title"] = "Chi tiết sản phẩm";
    var product = ViewBag.Product;
}
<h2>Chi tiết sản phẩm</h2>
<div class="row">
    <div class="col-md-4">
        <img src="@product.Image"
             style="width:100%; height:300px; object-fit:contain;" />
    </div>
    <div class="col-md-8">
        <h2>Sản phẩm: @product.Name</h2>
        <p>
            <del>Giá gốc: @product.Price.ToString("N0")</del>
            &nbsp;
            Giá mới: @product.SalePrice.ToString("N0")
        </p>
        <h4>Mô tả:</h4>
        <p>
            @product.Description
        </p>

        <h4>
            Trạng thái:
            @if (product.Status == 1)
            {
                <span>Còn hàng</span>
            }
            else
            {
                <span>Hết hàng</span>
            }
        </h4>
        <h4>
            Ngày đăng:
            @product.CreatedAt
        </h4>

        <hr />

        <a asp-controller="Product"
           asp-action="Index"
           class="btn btn-danger">
            Về danh sách
        </a>
    </div>
</div>