@model TaiSan
<h2>Sửa tài sản</h2>
<form asp-action="Edit" method="post">
    <input type="hidden" name="MaTs" value="@Model.MaTs"/>
    <div class="form-control">
        <label>MaLoai</label>
        <select name="MaLoai" class="form-control">
            @foreach(var lts in ViewBag.LoaiTaiSan)
                {
                   <option value="@lts.MaLoai" selected="@(lts.MaLoai==Model.MaLoai)">
                       @lts.TenLoai
                  </option>
                }
            </select>
    </div>
    <div class="form-control">
        <label>Tên tài sản</label>
        <input name="TenTs" class="form-control" value="@Model.TenTs"/>
    </div>
      <div class="form-control">
        <label>Gia</label>
        <input name="NguyenGia" class="form-control" value="@Model.NguyenGia"/>
    </div>
      <div class="form-control">
        <label>Anh</label>
        <input name="Anh" class="form-control" value="@Model.Anh"/>
    <button type="submit" class="btn btn-primary">Edit</button>
</form>