@model baitest1.Models.DataModels.Member

@{
    ViewData["Title"] = "Xóa Member";
}

<h3 class="text-danger">Bạn có chắc chắn muốn xóa thành viên này?</h3>
<hr />

<div>
    <dl class="row">
        <dt class="col-sm-3">Tên đăng nhập</dt>
        <dd class="col-sm-9">@Model.Username</dd>

        <dt class="col-sm-3">Họ và tên</dt>
        <dd class="col-sm-9">@Model.Fullname</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" name="memberId" value="@Model.MemberId" />
        <button type="submit" class="btn btn-danger">Xác nhận Xóa</button>
        <a asp-action="GetMembers" class="btn btn-secondary">Hủy bỏ</a>
    </form>
</div>