@{
    ViewData["Title"] = "Danh sách thành viên";
    @model IEnumerable<baitest1.Models.DataModels.Member>
}

<h2>Danh sách thành viên</h2>
<a href="/Member/Create" class="btn btn-primary">Thêm mới</a>
<table>
    <tr>
        <th>Mã sinh viên</th>
        <th>Username</th>
        <th>Họ và tên</th>
        <th>Password</th>
        <th>Email</th>
    </tr>

    @foreach (var m in ViewBag.members)
    {
        <tr>
            <td>@m.MemberId</td>
            <td>@m.Username</td>
            <td>@m.Fullname</td>
            <td>@m.Password</td>
            <td>@m.Email</td>
            <td>
                <a href="/Member/Edit/@m.MemberId" class="btn btn-warning btn-sm">Sửa</a>
                <a href="/Member/Details/@m.MemberId" class="btn btn-info btn-sm">Chi tiết</a>
                <a href="/Member/Delete/@m.MemberId" class="btn btn-danger btn-sm">Xóa</a>
            </td>
        </tr>
    }
</table>