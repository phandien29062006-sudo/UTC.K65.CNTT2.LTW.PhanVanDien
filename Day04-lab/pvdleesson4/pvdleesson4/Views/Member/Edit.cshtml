@model baitest1.Models.DataModels.Member

@{
    ViewData["Title"] = "Chỉnh sửa Member";
}

<h2>Chỉnh Sửa Thành Viên</h2>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post">
            @* Ẩn MemberId để gửi lên khi POST *@
            <input type="hidden" asp-for="MemberId" />

            <div class="form-group mb-3">
                <label asp-for="Username" class="control-label">Tên đăng nhập</label>
                <input asp-for="Username" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="Password" class="control-label">Mật khẩu</label>
                <input asp-for="Password" type="password" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="Fullname" class="control-label">Họ và tên</label>
                <input asp-for="Fullname" class="form-control" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="Email" class="control-label">Email</label>
                <input asp-for="Email" type="email" class="form-control" />
            </div>

            <div class="form-group mt-3">
                <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                <a asp-action="GetMembers" class="btn btn-secondary">Quay lại danh sách</a>
            </div>
        </form>
    </div>
</div>